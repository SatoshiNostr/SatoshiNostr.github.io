# ============================================================
# HyperLend Audit — Environment Variables
# Copy to .env in project root (../../.env) or here.
# NEVER commit .env with real values.
# ============================================================

# REQUIRED: Archive-capable RPC for historical getLogs (60 days).
# Providers: Alchemy, dRPC, Chainstack, QuickNode w/ HyperEVM support.
HYPEREVM_RPC_URL=

# Fallback RPC (public, 100 req/min, NO archive, no WS).
HYPEREVM_RPC_FALLBACK_1=https://rpc.hyperliquid.xyz/evm

# Optional second fallback
# HYPEREVM_RPC_FALLBACK_2=

# ---- Audit parameters ----
# Number of days to look back for liquidation history
DAYS_BACK=60

# Blocks per getLogs request. Start at 500; increase to 2000 with archive node.
# Reduce to 100-200 if you get "block range too large" errors.
CHUNK_SIZE=500

# Maximum chunk size (auto-scaling ceiling)
MAX_CHUNK_SIZE=2000

# Minimum net profit threshold for counting a liquidation as "capturable" (USD)
MIN_PROFIT_USDC=50

# ---- Price config ----
# HYPE token (native gas token on HyperEVM) price in USD.
# Used for gas cost calculation. Fetch current price from CoinGecko if blank.
HYPE_PRICE_USD=

# If set to 1, attempt to fetch oracle prices at the exact historical block
# (requires archive node). If 0, uses daily approximation (faster but less precise).
USE_HISTORICAL_PRICES=1
